#!/bin/sh
# HARD GATE: full build + test suite must pass before any push to the remote.
# A red suite (or a missing toolchain) BLOCKS the push. No silent skips —
# silent skips are how untested code reached main before.
echo "Running pre-push checks (hard gate)..."

# Load rbenv so the project's Ruby (.ruby-version, 3.2.x) is active.
if command -v rbenv > /dev/null 2>&1; then
    eval "$(rbenv init - 2>/dev/null)"
fi

# Toolchain must be present. If it's not, FAIL — don't skip.
if ! bundle exec jekyll --version > /dev/null 2>&1; then
    echo "✗ Jekyll/bundler not available."
    echo "  Set up the toolchain (rbenv + Ruby 3.2 + 'bundle install') before pushing,"
    echo "  or push with '--no-verify' ONLY if you understand the risk."
    exit 1
fi

if ! npx playwright --version > /dev/null 2>&1; then
    echo "✗ Playwright not installed."
    echo "  Run 'npm ci && npx playwright install chromium' before pushing."
    exit 1
fi

echo "Building Jekyll site..."
bundle exec jekyll build || exit 1

echo "Running full Playwright suite..."
# Clear any orphaned servers from previous runs so Playwright can own port 8080.
lsof -ti:8080 2>/dev/null | xargs kill -9 2>/dev/null || true
lsof -ti:18080 2>/dev/null | xargs kill -9 2>/dev/null || true
sleep 1
# PREPUSH=1 tells playwright.config.js to own the server lifecycle (reuseExistingServer=false)
PREPUSH=1 npm test || {
    echo "✗ Tests failed — push blocked. Fix the failures (do not bypass)."
    exit 1
}

echo "✓ All checks passed."
