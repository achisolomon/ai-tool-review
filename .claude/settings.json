{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto-commit-push.sh\"; [ -x \"$p\" ] && exec \"$p\"'",
            "timeout": 60,
            "statusMessage": "Auto-committing & pushing changes..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true
  }
}
